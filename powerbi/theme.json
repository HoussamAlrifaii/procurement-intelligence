  "background": "#FFFFFF",
  "backgroundLight": "#F5F5F3",
  "backgroundNeutral": "#E6E5E0",
  "secondaryBackground": "#F0EFEC",
  "tableAccent": "#2A78D6",
  "hyperlink": "#256ABF",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#104281",
  "center": "#86B6EF",
