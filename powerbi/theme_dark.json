{
  "name": "Procurement Intelligence Dark",
  "dataColors": [
    "#3987E5",
    "#D95926",
    "#199E70",
    "#C98500",
    "#D55181",
    "#008300",
    "#9085E9",
    "#E66767"
  ],
  "foreground": "#F0EFEC",
  "foregroundNeutralSecondary": "#C3C2B7",
  "foregroundNeutralTertiary": "#8E8D86",
  "background": "#1C1D22",
  "backgroundLight": "#24262C",
  "backgroundNeutral": "#2C2E35",
  "secondaryBackground": "#24262C",
  "tableAccent": "#3987E5",
  "hyperlink": "#86B6EF",
  "good": "#0CA30C",
  "neutral": "#C98500",
  "bad": "#E66767",
  "maximum": "#86B6EF",
  "center": "#3987E5",
  "minimum": "#184F95",
  "null": "#2C2E35",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#F0EFEC" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#F0EFEC" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#F0EFEC" },
    "label": { "fontSize": 9, "fontFace": "Segoe UI", "color": "#C3C2B7" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1C1D22" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2C2E35" } }, "radius": 10 }],
        "dropShadow": [{ "show": false }],
        "title": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12,
          "fontColor": { "solid": { "color": "#F0EFEC" } },
          "alignment": "left"
        }],
        "subTitle": [{ "show": false }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#C3C2B7" } },
          "showAxisTitle": false,
          "gridlineShow": false
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#8E8D86" } },
          "showAxisTitle": false,
          "gridlineColor": { "solid": { "color": "#2C2E35" } }
        }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#F0EFEC" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#C3C2B7" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0F1115" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0B0C0F" } }, "transparency": 0 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#8E8D86" } }, "textSize": 9 }],
        "items": [{
          "fontColor": { "solid": { "color": "#F0EFEC" } },
          "background": { "solid": { "color": "#24262C" } }
        }]
      }
    }
  }
}
