{
  "name": "Procurement Intelligence Midnight Indigo",
  "dataColors": [
    "#6366F1",
    "#06A3B8",
    "#D95926",
    "#9085E9",
    "#C98500",
    "#D55181",
    "#008300",
    "#E66767"
  ],
  "foreground": "#F3F4F6",
  "foregroundNeutralSecondary": "#9CA3AF",
  "foregroundNeutralTertiary": "#6B7280",
  "background": "#121826",
  "backgroundLight": "#1A2233",
  "backgroundNeutral": "#1F2937",
  "secondaryBackground": "#1A2233",
  "tableAccent": "#6366F1",
  "hyperlink": "#A5B4FC",
  "good": "#0CA30C",
  "neutral": "#C98500",
  "bad": "#E66767",
  "maximum": "#A5B4FC",
  "center": "#6366F1",
  "minimum": "#312E81",
  "null": "#1F2937",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#F3F4F6" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#F3F4F6" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#F3F4F6" },
    "label": { "fontSize": 9, "fontFace": "Segoe UI", "color": "#9CA3AF" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#121826" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#1F2937" } }, "radius": 10 }],
        "dropShadow": [{ "show": false }],
        "title": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12,
          "fontColor": { "solid": { "color": "#F3F4F6" } },
          "alignment": "left"
        }],
        "subTitle": [{ "show": false }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#9CA3AF" } },
          "showAxisTitle": false,
          "gridlineShow": false
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#6B7280" } },
          "showAxisTitle": false,
          "gridlineColor": { "solid": { "color": "#1F2937" } }
        }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#F3F4F6" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#9CA3AF" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B0F19" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#080B12" } }, "transparency": 0 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#9CA3AF" } }, "textSize": 9 }],
        "items": [{
          "fontColor": { "solid": { "color": "#F3F4F6" } },
          "background": { "solid": { "color": "#1A2233" } }
        }]
      }
    }
  }
}
