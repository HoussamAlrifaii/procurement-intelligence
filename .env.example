# Copy this file to .env and fill in real values. .env is git-ignored.
# Required from Phase 6 (AI assistant) onward.

# Free key from console.groq.com (API Keys). Any OpenAI-compatible provider works.
LLM_API_KEY=

# Optional: change provider or model without code changes.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# Google Gemini example:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
