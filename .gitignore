# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Secrets: never commit real keys
.env

# Data: re-created by the pipeline, too large for Git
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/marts/
data/analysis/
data/ml/
data/app/

# Trained models: re-created by the training scripts
models/
*.duckdb
*.duckdb.wal

# Power BI: .pbix files contain the imported data and are rebuilt locally;
# the measures and theme are committed as text in powerbi/.
*.pbix
**/.pbi/cache.abf
**/.pbi/localSettings.json

# OS / editor
.DS_Store
Thumbs.db
